# =============================================================================
# linux-backups — secrets template
#
# Copy this file to your CONFIG_DIR (default: /etc/linux-backups/secrets.env)
# and fill in the real values. NEVER commit the filled-in file.
#
# Reminder: the whole CONFIG_DIR is included in the backup, so these secrets end
# up inside the encrypted-at-rest tarball in Azure. That is intentional (full
# node restorability). If you do not want secrets in the backup, move this file
# outside CONFIG_DIR and source it separately.
# =============================================================================

# Azure Blob container URL WITHOUT the SAS token and WITHOUT a trailing slash.
# Example: https://myaccount.blob.core.windows.net/backups
export DEST_URL="https://<account>.blob.core.windows.net/<container>"

# SAS token query string, INCLUDING the leading '?'.
# Needs at least Create/Write permissions on the container.
# Example: ?sv=2023-01-03&ss=b&srt=co&sp=cw&se=2026-01-01T00:00:00Z&sig=...
export SAS_TOKEN="?sv=...&sp=...&sig=..."

# Prometheus Pushgateway base URL. Leave EMPTY to disable metric pushing
# (the run still succeeds; an INFO line is logged).
export PROM_GTW="https://prometheus-pushgateway.internal.asksven.io:443"
